# 이 파일을 .env 로 복사한 뒤 실제 키를 넣으세요. (.env 는 git에 올라가지 않습니다)
OPENAI_API_KEY=sk-여기에-키-입력

# Notion 공부 비서 (README의 'Notion 연결' 참고)
NOTION_TOKEN=ntn_여기에-토큰-입력
NOTION_DATA_SOURCE_ID=1935b3cb-7ea8-8208-88cd-879062753f13

# 다른 모델을 쓰고 싶으면 주석 해제 (기본값: gpt-5.4-mini)
# AGENT_MODEL=gpt-5.5
# 최종 프로젝트 갱신할 때만 쓰는 상위 모델 (기본 gpt-5.4)
# AGENT_MODEL_HEAVY=gpt-5.5

# 내 커밋 가져오기 (기본: 최종 프로젝트 저장소 / taemin1997)
